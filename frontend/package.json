    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.0",
    "typescript": "^5.8.0",
