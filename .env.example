# ========== 环境 ==========
# local | test | production
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://drama:drama@localhost:5432/drama
# Alembic 迁移使用的同步 URL（不带 +asyncpg 驱动前缀）
DATABASE_URL_SYNC=postgresql://drama:drama@localhost:5432/drama
# 设为 true 输出所有 SQL 语句（仅调试用）
DATABASE_ECHO=false
POSTGRES_USER=drama
POSTGRES_PASSWORD=drama
POSTGRES_DB=drama
POSTGRES_PORT=5432

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ========== 文件存储 ==========
ARTIFACT_FILE_ROOT=./var/artifacts
UPLOAD_FILE_ROOT=./var/uploads

# ========== LLM 调用 ==========
LLM_PROVIDER=openai_compatible
LLM_API_BASE=
LLM_API_KEY=
LLM_NORMALIZER_MODEL=
LLM_PLANNER_MODEL=
LLM_WRITER_MODEL=
LLM_EVALUATOR_MODEL=
LLM_REVISER_MODEL=
LLM_SUMMARIZER_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
# I-01 重试退避与 per-run 预算（留空用代码默认值）
LLM_RETRY_BASE_DELAY_SECONDS=
LLM_RETRY_FACTOR=
LLM_RETRY_MAX_DELAY_SECONDS=
RUN_MAX_LLM_CALLS=
RUN_MAX_LLM_CALLS_HARD=
RUN_MAX_LLM_TOKENS_HARD=

# ========== Embedding ==========
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# ========== MVP 参数 ==========
MVP_OUTLINE_COUNT=10
MVP_SCRIPT_COUNT=3
AUTO_REVISION_THRESHOLD=75
MAX_REVISION_ROUNDS=1
SHORT_TERM_MESSAGE_COUNT=12
CONTEXT_MAX_TOKENS=24000
RAG_TOP_K=5
UPLOAD_MAX_BYTES=10485760

# ========== CORS ==========
# 逗号分隔的允许来源列表，local 环境默认允许所有来源
CORS_ORIGINS=*

# ========== SSE ==========
SSE_HEARTBEAT_SECONDS=15

# ========== 可观测性 ==========
# GET /metrics 开关：false 时返回 404（埋点仍累积，可按需开启）
METRICS_ENABLED=true
