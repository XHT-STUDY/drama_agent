# ========== 环境 ==========
# local | test | production
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://drama:drama@localhost:5432/drama
# Alembic 迁移使用的同步 URL（不带 +asyncpg 驱动前缀）
DATABASE_URL_SYNC=postgresql://drama:drama@localhost:5432/drama
# 设为 true 输出所有 SQL 语句（仅调试用）
DATABASE_ECHO=false
POSTGRES_USER=drama
POSTGRES_PASSWORD=drama
POSTGRES_DB=drama
POSTGRES_PORT=5432

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ========== 文件存储 ==========
ARTIFACT_FILE_ROOT=./var/artifacts
UPLOAD_FILE_ROOT=./var/uploads
EXPORT_FILE_ROOT=./var/exports

# ========== LLM 调用 ==========
LLM_PROVIDER=openai_compatible
LLM_API_BASE=
LLM_API_KEY=
# 全局默认模型：角色模型未配置时回退到此值；留空则该角色调用前快速失败
# （404/401 等确定性错误不会重试，需修正配置后重跑）
LLM_MODEL=
LLM_NORMALIZER_MODEL=
LLM_PLANNER_MODEL=
LLM_WRITER_MODEL=
LLM_EVALUATOR_MODEL=
LLM_REVISER_MODEL=
LLM_SUMMARIZER_MODEL=
LLM_TIMEOUT_SECONDS=180
# 评估类调用独立超时（评估输出为大 JSON，慢速模型下需要更长预算）
LLM_EVAL_TIMEOUT_SECONDS=900
# 单次调用默认输出 token 上限（调用点未显式传 max_tokens 时生效；
# 不可超过所用模型的输出上限，否则请求会被提供方拒绝）
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=2
# I-01 重试退避与 per-run 预算（留空用代码默认值）
LLM_RETRY_BASE_DELAY_SECONDS=
LLM_RETRY_FACTOR=
LLM_RETRY_MAX_DELAY_SECONDS=
RUN_MAX_LLM_CALLS=
RUN_MAX_LLM_CALLS_HARD=
RUN_MAX_LLM_TOKENS_HARD=

# ========== Embedding ==========
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# ========== MVP 参数 ==========
MVP_OUTLINE_COUNT=10
MVP_SCRIPT_COUNT=3
AUTO_REVISION_THRESHOLD=75
MAX_REVISION_ROUNDS=1
SHORT_TERM_MESSAGE_COUNT=12
# 短期记忆 Redis 缓存 TTL（秒，滑动窗口）
SHORT_TERM_TTL_SECONDS=604800
# 会话消息数达到该值整数倍时生成对话摘要
CONVERSATION_SUMMARY_THRESHOLD=24
CONTEXT_MAX_TOKENS=24000
RAG_TOP_K=5
UPLOAD_MAX_BYTES=10485760

# ========== CORS ==========
# 逗号分隔的允许来源列表，local 环境默认允许所有来源
CORS_ORIGINS=*

# ========== SSE ==========
SSE_HEARTBEAT_SECONDS=15

# ========== 可观测性 ==========
# GET /metrics 开关：false 时返回 404（埋点仍累积，可按需开启）
METRICS_ENABLED=true

# ========== MCP 外部工具（I-04 / MCP-01+） ==========
# 默认关：主流程完全不受影响；启用后经官方 mcp SDK 连接标准 MCP Server
# （见 docs/EXTENSIONS.md 与 backend/app/integrations/mcp/）
MCP_ENABLED=false
# 多 Server 标准配置：JSON 数组，字段见 MCPServerConfig
# （id / url / enabled / allowed_tools / bearer_token_env / timeout_seconds /
#   max_concurrency / allow_private_network）
# MCP_SERVERS_JSON=[{"id":"research","url":"https://mcp.example.com/mcp","enabled":true,"allowed_tools":["search"],"bearer_token_env":"MCP_RESEARCH_TOKEN","timeout_seconds":30,"max_concurrency":4,"allow_private_network":false}]
# Token 只通过环境变量引用（bearer_token_env），值不写入配置/日志：
# MCP_RESEARCH_TOKEN=
# ---- 旧单 Server 配置（弃用，保留一个发布周期，缺失 MCP_SERVERS_JSON 时生效） ----
MCP_BASE_URL=
MCP_TIMEOUT_SECONDS=10.0

# 对话式创作工作台（前端）——设为 false 恢复 ChatInput + RunProgress 旧布局（无数据迁移回滚）
NEXT_PUBLIC_AGENT_WORKSPACE_ENABLED=true
